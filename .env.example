# Connection string pooled de Neon (la usa la app en runtime)
DATABASE_URL=

# Connection string directa de Neon, sin pooler (la usa la CLI de Prisma para migraciones)
DATABASE_URL_UNPOOLED=

# Clave para firmar los JWT de sesión. Generarla una sola vez con:
#   openssl rand -base64 32
AUTH_SECRET=
