# Connection string pooled de Neon (la usa la app en runtime)
DATABASE_URL=

# Connection string directa de Neon, sin pooler (la usa la CLI de Prisma para migraciones)
DATABASE_URL_UNPOOLED=

# Clave para firmar los JWT de sesión. Generarla una sola vez con:
#   openssl rand -base64 32
AUTH_SECRET=

# Envío de emails (orden de recepción) por SMTP. Si faltan, la recepción se
# registra igual y el sistema avisa al admin que imprima la orden.
#   Desarrollo: cuenta de prueba de Ethereal (https://ethereal.email/create).
#     Los emails no llegan a nadie: el link para verlos sale en la consola.
#     SMTP_HOST=smtp.ethereal.email  SMTP_PORT=587  SMTP_SECURE=false
#   Producción: Resend (SMTP_HOST=smtp.resend.com, SMTP_PORT=465,
#     SMTP_SECURE=true, SMTP_USER=resend, SMTP_PASS=<API key>).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Dirección remitente. El nombre que ve el cliente es el del taller.
EMAIL_FROM=
